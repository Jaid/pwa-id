{
  "name": "get-pwa-id",
  "version": "0.1.0",
  "type": "module",
  "description": "Compute Chromium PWA app IDs from URLs and web app manifests",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/pwa-id.git"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.4"
  },
  "engines": {
    "node": ">=22.1"
  },
  "files": [
    "dist",
    "license.txt",
    "readme.md"
  ]
}
